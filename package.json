{
  "name": "lunawindow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "tsc -b && vite build && mkdir -p dist/validation && cp dist/index.html dist/validation/index.html",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "horizons:proxy": "node server/horizons-proxy.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "cesium": "^1.147.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
